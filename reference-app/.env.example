# Copy this file to .env and fill in your real values.
# Get an OpenRouter API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here

# Which model to call. "openrouter/free" auto-routes to a free model.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Where traces are sent = the observability backend (your teammate's service).
OBSERVABILITY_TRACES_URL=http://localhost:8000/v1/traces

# API key the observability backend requires to accept traces (x-api-key header).
INGEST_API_KEY=your-ingest-api-key-here
